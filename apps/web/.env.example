# === MailKite Auth (required) ===
MAILKITE_API_URL=https://api.mailkite.dev
AUTH_SECRET=                    # openssl rand -base64 32

# === OAuth (optional — enables social login buttons) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Magic Link (optional) ===
MAILKITE_MAGIC_LINK=false

# === Email (MailKite) ===
MAILKITE_API_KEY=               # required to send: welcome email + contact form
MAILKITE_FROM=noreply@yourdomain.com   # must be on a verified MailKite domain
CONTACT_EMAIL=                  # where the contact form lands
CONTACT_FROM=                   # optional; defaults to MAILKITE_FROM

# === Email branding (optional — see lib/mailkite-auth/email-template.ts) ===
APP_NAME=SaaS Starter           # masthead, footer and subject lines
EMAIL_TAGLINE=Launch your SaaS. # footer line under the app name
EMAIL_LOGO_URL=                 # hosted PNG wordmark; falls back to a text mark
EMAIL_THEME=light               # light | dark

# === Database (choose one) ===
# PostgreSQL (Neon, Supabase, Vercel Postgres)
POSTGRES_URL=postgresql://***
# OR
# SQLite / Turso
SQLITE_DATABASE_URL=file:./local.db
# D1 via wrangler binding (no env var in prod)

# === Stripe (from saas-starter) ===
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
